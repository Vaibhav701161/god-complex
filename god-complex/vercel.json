{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm --filter web run build",
  "devCommand": "pnpm --filter web run dev",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "outputDirectory": "apps/web/.next",
  "ignoreCommand": "bash -c 'exit 0'",
  
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.godcomplex.app/api/:path*"
    }
  ]

}
