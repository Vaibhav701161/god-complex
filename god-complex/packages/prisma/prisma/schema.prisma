generator client {
  provider = "prisma-client-js"  
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GoalCategory {
  STUDY
  HEALTH
  CAREER
  BUILD
  SOCIAL
}

enum GoalStatus {
  COMPLETED
  MIN_EFFORT
  FAILED
}

enum FailureReason {
  POOR_PLANNING
  LOW_ENERGY
  DISTRACTION
  EXTERNAL_DEPENDENCY
  FEAR_AVOIDANCE
  SYSTEM_ASSIGNED
}


model User {
  id              String   @id @default(uuid())
  email           String   @unique
  name            String
  emailVerified   Boolean
  image           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  memberships     Membership[]
  goals           Goal[]
  goalResults     GoalResult[]
  monthlyOutcomes MonthlyOutcome[]
  penaltyAssignments PenaltyAssignment[]
  
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id           String    @id @default(cuid())
  userId       String
  accountId    String
  providerId   String
  accessToken  String?
  refreshToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope        String?
  password     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@map("verification")
}

model Group {
  id              String   @id @default(uuid())
  name            String
  monthlyPledge   Int
  cutoffHour      Int      
  createdAt       DateTime @default(now())

  memberships     Membership[]
  goals           Goal[]
  monthlyOutcomes MonthlyOutcome[]
  penaltyAssignments PenaltyAssignment[]
}


model Membership {
  id        String   @id @default(uuid())
  userId    String
  groupId   String
  month     String   
  joinedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  group     Group    @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId, month])
}

model Goal {
  id              String        @id @default(uuid())
  userId          String
  groupId         String
  date            DateTime      
  title           String
  category        GoalCategory
  finishCondition String
  minEffort       String
  isUncomfortable Boolean

  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id])
  group           Group    @relation(fields: [groupId], references: [id])
  result          GoalResult?

  @@unique([userId, groupId, date, title])
}


model GoalResult {
  id            String @id @default(uuid())
  goalId        String @unique
  userId        String

  status        GoalStatus
  failureReason FailureReason?
  recordedAt    DateTime @default(now())

  goal          Goal @relation(fields: [goalId], references: [id])
  user          User @relation(fields: [userId], references: [id])
}



model MonthlyOutcome {
  id                String   @id @default(uuid())
  userId            String
  groupId           String
  month             String   

  averageDailyScore Float
  activeDays        Int
  finalScore        Float
  rank              Int

  payoutAmount      Int
  penaltyAmount     Int
  platformFeeShare  Int

  createdAt         DateTime @default(now())

  user              User     @relation(fields: [userId], references: [id])
  group             Group    @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId, month])
}

model PenaltyAssignment {
  id          String   @id @default(cuid())
  userId      String
  groupId     String
  month       String

  penaltyType String
  dueDate     DateTime
  status      String   @default("PENDING") // PENDING | COMPLETED | FAILED

  createdAt   DateTime @default(now())
  completedAt DateTime?

  user        User     @relation(fields: [userId], references: [id])
  group       Group    @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId, month])
  @@index([status])
}
