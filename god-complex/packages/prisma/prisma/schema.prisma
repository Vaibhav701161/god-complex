// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum GoalCategory {
  STUDY
  HEALTH
  CAREER
  BUILD
  SOCIAL
}

enum GoalStatus {
  COMPLETED
  MIN_EFFORT
  FAILED
}

enum FailureReason {
  POOR_PLANNING
  LOW_ENERGY
  DISTRACTION
  EXTERNAL_DEPENDENCY
  FEAR_AVOIDANCE
  SYSTEM_ASSIGNED
}


model User {
  id              String   @id @default(uuid())
  email           String   @unique
  name            String
  emailVerified   Boolean
  image           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  applicationDone Boolean  @default(false)
  displayName     String?
  motivation      String?

  memberships     Membership[]
  goals           Goal[]
  goalResults     GoalResult[]
  monthlyOutcomes MonthlyOutcome[]
  penaltyAssignments PenaltyAssignment[]
  
  publicId        String?  @unique // "GC-XXXX-XX" - Optional for migration
  
  createdGroups   Group[]  @relation("GroupCreator")
  joinRequests    GroupJoinRequest[]
  
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("session")
}

model Account {
  id           String    @id @default(cuid())
  userId       String
  accountId    String
  providerId   String
  accessToken  String?
  refreshToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope        String?
  idToken      String?
  password     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([providerId, accountId])
  @@map("account")
}

model Verification {
  id         String    @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@index([identifier])
  @@index([value])
  @@index([expiresAt])
  @@map("verification")
}

model Group {
  id              String   @id @default(uuid())
  name            String
  monthlyPledge   Int
  cutoffHour      Int      
  createdAt       DateTime @default(now())

  timezone        String   @default("UTC")
  
  creatorId       String?   // Optional for existing groups during migration
  creator         User?     @relation("GroupCreator", fields: [creatorId], references: [id])
  
  joinRequests    GroupJoinRequest[]
  dailyFinalizations DailyFinalization[]
  auditLogs       AuditLog[]
  
  memberships     Membership[]
  goals           Goal[]
  monthlyOutcomes MonthlyOutcome[]
  penaltyAssignments PenaltyAssignment[]
}


model Membership {
  id        String   @id @default(uuid())
  userId    String
  groupId   String
  month     String   
  joinedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  group     Group    @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId, month])
}

model Goal {
  id              String        @id @default(uuid())
  userId          String
  groupId         String
  date            DateTime      
  title           String
  category        GoalCategory
  finishCondition String
  minEffort       String
  isUncomfortable Boolean
  isLocked        Boolean @default(false)

  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id])
  group           Group    @relation(fields: [groupId], references: [id])
  result          GoalResult?

  @@unique([userId, groupId, date, title])
}


model GoalResult {
  id            String @id @default(uuid())
  goalId        String @unique
  userId        String

  status        GoalStatus
  failureReason FailureReason?
  recordedAt    DateTime @default(now())

  goal          Goal @relation(fields: [goalId], references: [id])
  user          User @relation(fields: [userId], references: [id])
}




// INVARIANT: Immutable once created. 
// No write path may change user-visible rank, score, or loser status for that month, 
// except via an explicit ADMIN action with REVERSED verdict and full audit context.
model MonthlyOutcome {
  id                String   @id @default(uuid())
  userId            String
  groupId           String
  month             String   

  averageDailyScore Float
  activeDays        Int
  finalScore        Float
  rank              Int

  payoutAmount      Int
  penaltyAmount     Int
  platformFeeShare  Int

  createdAt         DateTime @default(now())

  user              User     @relation(fields: [userId], references: [id])
  group             Group    @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId, month])
}

model PenaltyAssignment {
  id          String   @id @default(cuid())
  userId      String
  groupId     String
  month       String

  penaltyType String
  dueDate     DateTime
  status      PenaltyStatus   @default(PENDING)
  appealReason    String?
  resolutionNotes String?
  verdict         PenaltyVerdict? // NULL = Pending/None, UPHELD, REVERSED
  resolvedAt      DateTime?

  createdAt   DateTime @default(now())
  completedAt DateTime?

  user        User     @relation(fields: [userId], references: [id])
  group       Group    @relation(fields: [groupId], references: [id])

  @@unique([userId, groupId, month])
  @@index([status])
}

model DailyFinalization {
  id          String   @id @default(uuid())
  groupId     String
  date        String   // "YYYY-MM-DD" in Group Time
  
  dayStartUTC DateTime
  dayEndUTC   DateTime
  cutoffUTC   DateTime
  
  status      DayStatus @default(PENDING)
  
  finalizedAt DateTime?
  metadata    Json?
  
  group       Group     @relation(fields: [groupId], references: [id])
  
  @@unique([groupId, date])
  @@index([status])
  @@map("daily_finalization")
}

model AuditLog {
  id          String   @id @default(uuid())
  action      String
  actorId     String?
  
  targetId    String
  targetType  String
  
  changes     Json?
  createdAt   DateTime @default(now())
  
  source      AuditSource @default(SYSTEM)
  reason      String?
  correlationId String?
  
  groupId     String?
  group       Group?   @relation(fields: [groupId], references: [id])

  @@map("audit_log")
}

enum AuditSource {
  SYSTEM
  CRON
  ADMIN
  USER
}

enum DayStatus {
  PENDING
  FINALIZED
  RECONCILED
}

enum PenaltyStatus {
  PENDING
  COMPLETED
  FAILED
  APPEALED
  RESOLVED
}

enum PenaltyVerdict {
  UPHELD
  REVERSED
}

model GroupJoinRequest {
  id        String   @id @default(cuid())
  groupId   String
  userId    String
  status    JoinStatus
  createdAt DateTime @default(now())

  group     Group    @relation(fields: [groupId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([groupId, userId])
}

enum JoinStatus {
  PENDING
  APPROVED
  REJECTED
}
