# =============================================================================
# PRISMA DATABASE CONFIGURATION
# =============================================================================
# Copy this file to .env: cp .env.example .env

# Database connection string
# -----------------------------------------------------------------------------
# LOCAL DEVELOPMENT (Docker):
# postgresql://godcomplex:godcomplex@localhost:5432/godcomplex
#
# SERVERLESS (Neon/Supabase):
# postgresql://user:password@host/database?sslmode=require
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://godcomplex:godcomplex@localhost:5432/godcomplex"

# Use PG Adapter for serverless PostgreSQL
# -----------------------------------------------------------------------------
# Set to 'true' for serverless PostgreSQL (Neon, Supabase, etc.)
# Set to 'false' for local Docker PostgreSQL (recommended for development)
# -----------------------------------------------------------------------------
USE_PG_ADAPTER=false
