# Frontend Environment Variables for Vercel

# Your deployed Vercel app URL (e.g., https://god-complex.vercel.app)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Your Railway backend API URL (e.g., https://your-backend.railway.app)
NEXT_PUBLIC_API_URL=https://your-backend.railway.app

# Canonical Frontend URL
NEXT_PUBLIC_SITE_URL=https://www.godcomplex.app

