# =============================================================================
# HTTP SERVER CONFIGURATION
# =============================================================================
# Copy this file to .env: cp .env.example .env

# =============================================================================
# DATABASE
# =============================================================================

# Database connection string (same as packages/prisma/.env)
# LOCAL: postgresql://godcomplex:godcomplex@localhost:5432/godcomplex
# SERVERLESS: postgresql://user:password@host/database?sslmode=require
DATABASE_URL="postgresql://godcomplex:godcomplex@localhost:5432/godcomplex"

# Set to true for serverless PostgreSQL (Neon, Supabase)
# Set to false for local Docker PostgreSQL
USE_PG_ADAPTER=false

# =============================================================================
# BETTER AUTH
# =============================================================================

# Secret for signing tokens - CHANGE IN PRODUCTION!
# Generate: openssl rand -hex 32
BETTER_AUTH_SECRET="your-secure-secret-here"

# Auth server base URL
BETTER_AUTH_URL="http://localhost:4000"

# =============================================================================
# OAUTH (Optional)
# =============================================================================

# Google OAuth credentials (get from Google Cloud Console)
# Leave empty to disable Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# =============================================================================
# EMAIL (Optional)
# =============================================================================

# Email provider: console | resend | sendgrid
EMAIL_PROVIDER=console

# Resend API key (if using Resend)
RESEND_API_KEY=""

# From email address
EMAIL_FROM="noreply@godcomplex.local"

# =============================================================================
# APPLICATION
# =============================================================================

# Enable cron jobs for daily/monthly processing
ENABLE_CRON=true

# Node environment
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# Trusted origins for CORS (comma-separated)
TRUSTED_ORIGINS="http://localhost:3000,http://localhost:4000"
