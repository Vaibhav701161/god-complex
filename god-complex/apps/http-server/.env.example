# Enable cron jobs for daily/monthly processing
ENABLE_CRON=true

# Database connection string (same as packages/prisma/.env)
DATABASE_URL="postgresql://user:password@localhost:5432/godcomplex?sslmode=require"

# Better Auth configuration
# Generate a secure secret: openssl rand -hex 32
BETTER_AUTH_SECRET="your-secure-secret-here"
BETTER_AUTH_URL="http://localhost:4000"

# Google OAuth credentials (get from Google Cloud Console)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Set to true to use PG adapter for serverless PostgreSQL
USE_PG_ADAPTER=false

# Node environment
NODE_ENV=development
