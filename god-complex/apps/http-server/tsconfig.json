{
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "module": "CommonJS",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "outDir": "./build",
    "rootDir": "./src",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@god-complex/prisma": [
        "../../packages/prisma/dist"
      ]
    }
  },
  "include": [
    "src/**/*"
  ]
}