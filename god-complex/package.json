{
  "name": "god-complex",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d postgres",
    "db:logs": "docker compose logs -f postgres",
    "db:studio": "docker compose --profile tools up -d pgadmin",
    "db:migrate": "pnpm --filter @god-complex/prisma exec prisma migrate dev",
    "db:push": "pnpm --filter @god-complex/prisma exec prisma db push",
    "db:seed": "pnpm --filter @god-complex/prisma exec prisma db seed",
    "setup": "bash scripts/setup-env.sh",
    "validate": "bash scripts/validate-setup.sh"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "prettier": "^3.7.4",
    "turbo": "^2.7.2",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
