# =============================================================================
# GOD COMPLEX - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values
# Run: cp .env.example .env

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# Local PostgreSQL (Docker)
POSTGRES_USER=godcomplex
POSTGRES_PASSWORD=godcomplex
POSTGRES_DB=godcomplex

# Database connection string
# For local Docker: postgresql://godcomplex:godcomplex@localhost:5432/godcomplex
# For serverless (Neon/Supabase): postgresql://user:password@host/database?sslmode=require
DATABASE_URL="postgresql://godcomplex:godcomplex@localhost:5432/godcomplex"

# Set to true to use PG adapter for serverless PostgreSQL (Neon, Supabase, etc.)
# Set to false for local Docker PostgreSQL
USE_PG_ADAPTER=false

# =============================================================================
# BETTER AUTH CONFIGURATION
# =============================================================================

# Secret key for signing tokens - MUST be changed in production!
# Generate using: openssl rand -hex 32
BETTER_AUTH_SECRET="change-me-in-production-generate-with-openssl-rand-hex-32"

# Base URL for the auth server
BETTER_AUTH_URL="http://localhost:4000"

# =============================================================================
# OAUTH PROVIDERS (Optional)
# =============================================================================

# Google OAuth credentials (get from Google Cloud Console)
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Node environment: development | production | test
NODE_ENV=development

# Enable cron jobs for daily/monthly processing
ENABLE_CRON=true

# Frontend URL (for CORS and redirects)
FRONTEND_URL="http://localhost:3000"

# =============================================================================
# EMAIL CONFIGURATION (Optional)
# =============================================================================

# Email provider: console | resend | sendgrid
EMAIL_PROVIDER=console

# Resend API key (if using Resend)
RESEND_API_KEY=""

# From email address
EMAIL_FROM="noreply@godcomplex.local"

# =============================================================================
# PGADMIN (Optional - for database UI)
# =============================================================================

PGADMIN_EMAIL=admin@godcomplex.local
PGADMIN_PASSWORD=admin
